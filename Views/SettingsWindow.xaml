<Window x:Class="dikit.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Dikit settings"
        Width="420"
        SizeToContent="Height"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        FontFamily="{StaticResource AppFont}"
        Background="{DynamicResource AppBackgroundBrush}"
        Icon="pack://application:,,,/Resources/dikit.ico">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Text="Settings" FontSize="18" FontWeight="SemiBold"
                   Foreground="{DynamicResource AppTextBrush}"/>

        <CheckBox Grid.Row="1"
                  Content="Use dark appearance"
                  IsChecked="{Binding IsDarkAppearance, Mode=TwoWay}"
                  FontSize="13"
                  Foreground="{DynamicResource AppTextBrush}"
                  Margin="0,14,0,0"
                  VerticalContentAlignment="Center"
                  AutomationProperties.Name="Dark appearance"/>

        <CheckBox Grid.Row="2"
                  Content="Launch Dikit when Windows signs in"
                  IsChecked="{Binding LaunchAtSignIn, Mode=TwoWay}"
                  FontSize="13"
                  Foreground="{DynamicResource AppTextBrush}"
                  Margin="0,8,0,0"
                  VerticalContentAlignment="Center"/>

        <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="0,12,0,0">
            <TextBlock Text="Backups kept per note"
                       FontSize="12"
                       Foreground="{DynamicResource AppMutedTextBrush}"
                       VerticalAlignment="Center"/>
            <TextBox Text="{Binding BackupRetention, UpdateSourceTrigger=PropertyChanged, Delay=400}"
                     Width="48"
                     Margin="8,0,0,0"
                     Padding="4,2"
                     FontSize="12"
                     HorizontalContentAlignment="Center"
                     Background="{DynamicResource AppSurfaceBrush}"
                     Foreground="{DynamicResource AppTextBrush}"
                     BorderBrush="{DynamicResource AppBorderBrush}"
                     AutomationProperties.Name="Backups kept per note"/>
        </StackPanel>

        <StackPanel Grid.Row="4" Margin="0,14,0,0">
            <TextBlock Text="Data folder" FontSize="12"
                       Foreground="{DynamicResource AppMutedTextBrush}"/>
            <TextBlock Text="{Binding DataFolderPath}"
                       FontSize="11"
                       Foreground="{DynamicResource AppTextBrush}"
                       Margin="0,2,0,0"
                       TextWrapping="Wrap"/>
            <Button Style="{StaticResource ChromeButton}"
                    Click="OpenDataFolder_Click"
                    FontWeight="SemiBold"
                    HorizontalAlignment="Left"
                    Margin="-8,6,0,0"
                    ToolTip="Open in File Explorer"
                    Content="Open data folder"/>
        </StackPanel>

        <TextBlock Grid.Row="5"
                   Text="Closing windows keeps Dikit in the system tray. Use Quit to exit."
                   FontSize="11"
                   Foreground="{DynamicResource AppMutedTextBrush}"
                   Margin="0,16,0,0"
                   TextWrapping="Wrap"/>
    </Grid>
</Window>
