<Window x:Class="dikit.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Dikit settings"
        Width="420"
        SizeToContent="Height"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        FontFamily="{StaticResource AppFont}"
        Background="#FFFDF5"
        Icon="pack://application:,,,/Resources/dikit.ico">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Text="Settings" FontSize="18" FontWeight="SemiBold" Foreground="#3B3A30"/>

        <CheckBox Grid.Row="1"
                  Content="Launch Dikit when Windows signs in"
                  IsChecked="{Binding LaunchAtSignIn, Mode=TwoWay}"
                  FontSize="13"
                  Foreground="#3B3A30"
                  Margin="0,14,0,0"
                  VerticalContentAlignment="Center"/>

        <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,12,0,0">
            <TextBlock Text="Backups kept per note"
                       FontSize="12"
                       Foreground="#6B6750"
                       VerticalAlignment="Center"/>
            <TextBox Text="{Binding BackupRetention, UpdateSourceTrigger=PropertyChanged, Delay=400}"
                     Width="48"
                     Margin="8,0,0,0"
                     Padding="4,2"
                     FontSize="12"
                     HorizontalContentAlignment="Center"/>
        </StackPanel>

        <StackPanel Grid.Row="3" Margin="0,14,0,0">
            <TextBlock Text="Data folder" FontSize="12" Foreground="#6B6750"/>
            <TextBlock Text="{Binding DataFolderPath}"
                       FontSize="11"
                       Foreground="#3B3A30"
                       Margin="0,2,0,0"
                       TextWrapping="Wrap"/>
            <Button Style="{StaticResource ChromeButton}"
                    Click="OpenDataFolder_Click"
                    Foreground="#3B3A30"
                    FontWeight="SemiBold"
                    HorizontalAlignment="Left"
                    Margin="-8,6,0,0"
                    ToolTip="Open in File Explorer"
                    Content="Open data folder"/>
        </StackPanel>

        <TextBlock Grid.Row="4"
                   Text="Closing windows keeps Dikit in the system tray. Use Quit to exit."
                   FontSize="11"
                   Foreground="#8A8668"
                   Margin="0,16,0,0"
                   TextWrapping="Wrap"/>
    </Grid>
</Window>
