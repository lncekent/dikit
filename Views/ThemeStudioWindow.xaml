<Window x:Class="dikit.Views.ThemeStudioWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{Binding Title}"
        Width="680"
        Height="500"
        MinWidth="560"
        MinHeight="420"
        WindowStartupLocation="CenterOwner"
        FontFamily="{StaticResource AppFont}"
        Background="{DynamicResource AppBackgroundBrush}"
        Icon="pack://application:,,,/Resources/dikit.ico">

    <Grid Margin="18">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="190"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <StackPanel>
            <TextBlock Text="Presets" FontSize="13" FontWeight="SemiBold"
                       Foreground="{DynamicResource AppTextBrush}"/>
            <TextBlock Text="Custom presets can be removed."
                       FontSize="11"
                       Foreground="{DynamicResource AppMutedTextBrush}"
                       TextWrapping="Wrap"
                       Margin="0,2,0,0"/>
            <ScrollViewer Margin="0,8,12,0" VerticalScrollBarVisibility="Auto">
                <ItemsControl ItemsSource="{Binding Presets}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="0,0,0,8">
                                <Button Style="{StaticResource ChromeButton}"
                                        Command="{Binding DataContext.SelectPresetCommand, RelativeSource={RelativeSource AncestorType={x:Type Window}}}"
                                        CommandParameter="{Binding}"
                                        HorizontalContentAlignment="Stretch"
                                        Padding="0"
                                        AutomationProperties.Name="{Binding Name, StringFormat='Preset theme {0}'}">
                                    <Border CornerRadius="10"
                                            Padding="10,8"
                                            Background="{Binding Background, Converter={StaticResource HexToBrush}}"
                                            BorderBrush="{DynamicResource AppBorderBrush}"
                                            BorderThickness="1">
                                        <StackPanel>
                                            <TextBlock Text="{Binding Name}"
                                                       FontSize="12"
                                                       FontWeight="SemiBold"
                                                       Foreground="{Binding Foreground, Converter={StaticResource HexToBrush}}"/>
                                            <StackPanel Orientation="Horizontal" Margin="0,5,0,0">
                                                <Border Width="14" Height="14" CornerRadius="7"
                                                        Background="{Binding Accent, Converter={StaticResource HexToBrush}}"
                                                        BorderBrush="{DynamicResource AppBorderBrush}"
                                                        BorderThickness="1"/>
                                                <Border Width="14" Height="14" CornerRadius="7" Margin="4,0,0,0"
                                                        Background="{Binding Foreground, Converter={StaticResource HexToBrush}}"
                                                        BorderBrush="{DynamicResource AppBorderBrush}"
                                                        BorderThickness="1"/>
                                            </StackPanel>
                                        </StackPanel>
                                    </Border>
                                </Button>
                                <Button Style="{StaticResource ChromeButton}"
                                        Command="{Binding DataContext.DeletePresetCommand, RelativeSource={RelativeSource AncestorType={x:Type Window}}}"
                                        CommandParameter="{Binding}"
                                        HorizontalAlignment="Right"
                                        VerticalAlignment="Top"
                                        Margin="0,2,2,0"
                                        Padding="5,1"
                                        Foreground="{DynamicResource AppDangerBrush}"
                                        Visibility="{Binding IsBuiltIn, Converter={StaticResource TrueToCollapsed}}"
                                        ToolTip="Delete this custom preset"
                                        AutomationProperties.Name="{Binding Name, StringFormat='Delete preset {0}'}"
                                        Content="×"/>
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </StackPanel>

        <StackPanel Grid.Column="1">
            <Border Padding="14,12"
                    CornerRadius="{Binding Working.CornerRadius, Converter={StaticResource ToCornerRadius}}"
                    Background="{Binding Working.Background, Converter={StaticResource HexToBrush}}"
                    BorderBrush="{DynamicResource AppBorderBrush}"
                    BorderThickness="1"
                    Opacity="{Binding Working.Opacity}">
                <StackPanel>
                    <TextBlock Text="Preview note"
                               FontSize="13"
                               FontWeight="SemiBold"
                               FontFamily="{Binding Working.FontFamily, Converter={StaticResource FontFamilyString}}"
                               Foreground="{Binding Working.Foreground, Converter={StaticResource HexToBrush}}"/>
                    <Border Height="1" Margin="0,6,0,6" Opacity="0.45"
                            Background="{Binding Working.Accent, Converter={StaticResource HexToBrush}}"/>
                    <TextBlock Text="Type your thought here…"
                               FontSize="12"
                               FontFamily="{Binding Working.FontFamily, Converter={StaticResource FontFamilyString}}"
                               Foreground="{Binding Working.Foreground, Converter={StaticResource HexToBrush}}"/>
                    <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                        <Border Width="12" Height="12" Margin="0,0,6,0" VerticalAlignment="Center"
                                CornerRadius="3"
                                BorderThickness="1.5"
                                BorderBrush="{Binding Working.Accent, Converter={StaticResource HexToBrush}}"/>
                        <TextBlock Text="Checklist item"
                                   FontSize="12"
                                   VerticalAlignment="Center"
                                   FontFamily="{Binding Working.FontFamily, Converter={StaticResource FontFamilyString}}"
                                   Foreground="{Binding Working.Foreground, Converter={StaticResource HexToBrush}}"/>
                    </StackPanel>
                    <TextBlock Text="https://example.com"
                               FontSize="11"
                               Margin="0,4,0,0"
                               TextDecorations="Underline"
                               FontFamily="{Binding Working.FontFamily, Converter={StaticResource FontFamilyString}}"
                               Foreground="{Binding Working.Accent, Converter={StaticResource HexToBrush}}"/>
                </StackPanel>
            </Border>

            <Grid Margin="0,12,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <RadioButton GroupName="ColorTarget"
                             IsChecked="True"
                             Checked="ColorTarget_Checked"
                             Tag="Background"
                             Content="Background"
                             FontSize="12"
                             Foreground="{DynamicResource AppTextBrush}"
                             Margin="0,0,12,0"
                             VerticalAlignment="Center"/>
                <RadioButton Grid.Column="1"
                             GroupName="ColorTarget"
                             Checked="ColorTarget_Checked"
                             Tag="Foreground"
                             Content="Text"
                             FontSize="12"
                             Foreground="{DynamicResource AppTextBrush}"
                             Margin="0,0,12,0"
                             VerticalAlignment="Center"/>
                <RadioButton Grid.Column="2"
                             GroupName="ColorTarget"
                             Checked="ColorTarget_Checked"
                             Tag="Accent"
                             Content="Accent"
                             FontSize="12"
                             Foreground="{DynamicResource AppTextBrush}"
                             Margin="0,0,12,0"
                             VerticalAlignment="Center"/>
                <TextBox Grid.Column="3"
                         Text="{Binding EditingColorHex, UpdateSourceTrigger=PropertyChanged, Delay=200}"
                         FontSize="12"
                         Padding="6,3"
                         HorizontalAlignment="Right"
                         MinWidth="110"
                         Background="{DynamicResource AppSurfaceBrush}"
                         Foreground="{DynamicResource AppTextBrush}"
                         CaretBrush="{DynamicResource AppTextBrush}"
                         BorderBrush="{DynamicResource AppBorderBrush}"
                         ToolTip="Hex color, e.g. #FFFFFFFF"
                         AutomationProperties.Name="Hex color value"/>
            </Grid>

            <WrapPanel Margin="0,8,0,0">
                <ItemsControl ItemsSource="{Binding Palette}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Button Style="{StaticResource SwatchButton}"
                                    Command="{Binding DataContext.PickColorCommand, RelativeSource={RelativeSource AncestorType={x:Type Window}}}"
                                    CommandParameter="{Binding}"
                                    Background="{Binding Converter={StaticResource HexToBrush}}"
                                    ToolTip="{Binding}"
                                    AutomationProperties.Name="{Binding Path=., StringFormat='Color swatch {0}'}"/>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </WrapPanel>

            <Grid Margin="0,10,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="Font" FontSize="11"
                               Foreground="{DynamicResource AppMutedTextBrush}"/>
                    <ComboBox ItemsSource="{Binding FontNames}"
                              SelectedItem="{Binding Working.FontFamily, Mode=TwoWay}"
                              IsEditable="True"
                              FontSize="12"
                              Background="{DynamicResource AppSurfaceBrush}"
                              Foreground="{DynamicResource AppTextBrush}"
                              Margin="0,3,12,0"
                              AutomationProperties.Name="Font family"/>
                </StackPanel>
                <StackPanel Grid.Column="1">
                    <TextBlock Text="Theme name (for saving)" FontSize="11"
                               Foreground="{DynamicResource AppMutedTextBrush}"/>
                    <TextBox Text="{Binding Working.Name, UpdateSourceTrigger=PropertyChanged, Delay=200}"
                             FontSize="12"
                             Padding="4,2"
                             Margin="0,3,0,0"
                             Background="{DynamicResource AppSurfaceBrush}"
                             Foreground="{DynamicResource AppTextBrush}"
                             CaretBrush="{DynamicResource AppTextBrush}"
                             BorderBrush="{DynamicResource AppBorderBrush}"
                             AutomationProperties.Name="Theme name"/>
                </StackPanel>
            </Grid>

            <StackPanel Margin="0,10,0,0">
                <TextBlock FontSize="11" Foreground="{DynamicResource AppMutedTextBrush}">
                    <Run Text="Corner radius:"/><Run Text="{Binding Working.CornerRadius, StringFormat={}{0:0}}"/>
                </TextBlock>
                <Slider Minimum="0" Maximum="28" TickFrequency="1" IsSnapToTickEnabled="True"
                        Value="{Binding Working.CornerRadius, Mode=TwoWay}"
                        AutomationProperties.Name="Corner radius"/>
                <TextBlock FontSize="11" Foreground="{DynamicResource AppMutedTextBrush}" Margin="0,4,0,0">
                    <Run Text="Opacity:"/><Run Text="{Binding Working.Opacity, StringFormat={}{0:P0}}"/>
                </TextBlock>
                <Slider Minimum="0.4" Maximum="1" TickFrequency="0.05" IsSnapToTickEnabled="True"
                        Value="{Binding Working.Opacity, Mode=TwoWay}"
                        AutomationProperties.Name="Opacity"/>
            </StackPanel>

            <StackPanel Orientation="Horizontal" Margin="0,12,0,0" HorizontalAlignment="Right">
                <Button Style="{StaticResource ChromeButton}"
                        Command="{Binding ResetToInheritedCommand}"
                        Foreground="{DynamicResource AppMutedTextBrush}"
                        ToolTip="This note inherits the global theme again"
                        Content="Inherit global"/>
                <Button Style="{StaticResource ChromeButton}"
                        Command="{Binding SaveAsPresetCommand}"
                        Foreground="{DynamicResource AppMutedTextBrush}"
                        Margin="6,0,0,0"
                        ToolTip="Save as a reusable theme in themes/"
                        Content="Save as preset"/>
                <Button Style="{StaticResource ChromeButton}"
                        Command="{Binding ApplyToAllCommand}"
                        Margin="6,0,0,0"
                        ToolTip="Apply to every note"
                        Content="Apply to all notes"/>
                <Button Style="{StaticResource ChromeButton}"
                        Command="{Binding ApplyToNoteCommand}"
                        FontWeight="SemiBold"
                        Margin="6,0,0,0"
                        ToolTip="Apply to this note only"
                        Content="Apply to this note"/>
            </StackPanel>
        </StackPanel>
    </Grid>
</Window>
