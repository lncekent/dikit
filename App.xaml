<Application x:Class="dikit.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:infra="clr-namespace:dikit.Infrastructure"
             ShutdownMode="OnExplicitShutdown">
    <Application.Resources>

        <infra:HexToBrushConverter x:Key="HexToBrush"/>
        <infra:DoubleToCornerRadiusConverter x:Key="ToCornerRadius"/>
        <infra:ZeroToCollapsedConverter x:Key="ZeroToCollapsed"/>
        <infra:NullToVisibleConverter x:Key="NullToVisible"/>
        <infra:TrueToCollapsedConverter x:Key="TrueToCollapsed"/>
        <infra:FontFamilyStringConverter x:Key="FontFamilyString"/>
        <infra:PathToBitmapConverter x:Key="PathToBitmap"/>

        <FontFamily x:Key="AppFont">./Resources/Fonts/#Inter, Segoe UI</FontFamily>

        <SolidColorBrush x:Key="AppBackgroundBrush" Color="#FFFDF5"/>
        <SolidColorBrush x:Key="AppSurfaceBrush" Color="#FFFFFF"/>
        <SolidColorBrush x:Key="AppSurfaceAltBrush" Color="#F4F2EA"/>
        <SolidColorBrush x:Key="AppTextBrush" Color="#3B3A30"/>
        <SolidColorBrush x:Key="AppMutedTextBrush" Color="#8A8668"/>
        <SolidColorBrush x:Key="AppBorderBrush" Color="#1F000000"/>
        <SolidColorBrush x:Key="AppHoverBrush" Color="#24000000"/>
        <SolidColorBrush x:Key="AppCheckedBrush" Color="#3A000000"/>
        <SolidColorBrush x:Key="AppDangerBrush" Color="#A33B3B"/>
        <SolidColorBrush x:Key="RecoveryBackgroundBrush" Color="#FFF3CD"/>
        <SolidColorBrush x:Key="RecoveryBorderBrush" Color="#E8C547"/>
        <SolidColorBrush x:Key="RecoveryTextBrush" Color="#6B5B1E"/>

        <Style x:Key="ChromeButton" TargetType="ButtonBase">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource AppTextBrush}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="7,2"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ButtonBase">
                        <Border x:Name="ChromeBorder"
                                Background="{TemplateBinding Background}"
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="{DynamicResource AppHoverBrush}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="BlockTextBox" TargetType="TextBox">
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Padding" Value="2,3"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="AcceptsReturn" Value="True"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

        <Style x:Key="SwatchButton" TargetType="ButtonBase">
            <Setter Property="Width" Value="26"/>
            <Setter Property="Height" Value="26"/>
            <Setter Property="Margin" Value="0,0,6,6"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ButtonBase">
                        <Border CornerRadius="13"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{DynamicResource AppBorderBrush}"
                                BorderThickness="1"/>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="BorderBrush" Value="{DynamicResource AppTextBrush}"/>
                                <Setter Property="BorderThickness" Value="1.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="AppToggle" TargetType="ToggleButton">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource AppTextBrush}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="7,2"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="ChromeBorder"
                                Background="{TemplateBinding Background}"
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="{DynamicResource AppHoverBrush}"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter Property="Background" Value="{DynamicResource AppCheckedBrush}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

    </Application.Resources>
</Application>
