<Window x:Class="dikit.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Dikit"
        Width="440"
        Height="520"
        MinWidth="380"
        MinHeight="300"
        WindowStartupLocation="CenterScreen"
        FontFamily="{StaticResource AppFont}"
        Background="{DynamicResource AppBackgroundBrush}"
        Icon="pack://application:,,,/Resources/dikit.ico">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid>
            <StackPanel>
                <TextBlock Text="Dikit" FontSize="22" FontWeight="SemiBold"
                           Foreground="{DynamicResource AppTextBrush}"/>
                <TextBlock Text="Stick your thoughts, your way."
                           FontSize="12"
                           Foreground="{DynamicResource AppMutedTextBrush}"
                           Margin="0,2,0,0"/>
            </StackPanel>
            <ToggleButton Style="{StaticResource AppToggle}"
                          IsChecked="{Binding IsDarkAppearance, Mode=TwoWay}"
                          HorizontalAlignment="Right"
                          VerticalAlignment="Top"
                          Content="Dark"
                          ToolTip="Use dark app colors"
                          AutomationProperties.Name="Dark mode"
                          Foreground="{DynamicResource AppTextBrush}"/>
        </Grid>

        <Border Grid.Row="1"
                Margin="0,14,0,0"
                Padding="10,8"
                CornerRadius="10"
                Background="{DynamicResource RecoveryBackgroundBrush}"
                BorderBrush="{DynamicResource RecoveryBorderBrush}"
                BorderThickness="1"
                Visibility="{Binding LoadWarnings.Count, Converter={StaticResource ZeroToCollapsed}}">
            <StackPanel>
                <TextBlock Text="Recovery notices"
                           FontWeight="SemiBold"
                           FontSize="12"
                           Foreground="{DynamicResource RecoveryTextBrush}"/>
                <ItemsControl ItemsSource="{Binding LoadWarnings}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding}"
                                       TextWrapping="Wrap"
                                       FontSize="11"
                                       Foreground="{DynamicResource RecoveryTextBrush}"
                                       Margin="0,2,0,0"/>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </Border>

        <Border Grid.Row="2"
                Margin="0,14,0,0"
                Padding="1"
                CornerRadius="10"
                Background="{DynamicResource AppSurfaceBrush}"
                BorderBrush="{DynamicResource AppBorderBrush}"
                BorderThickness="1"
                Opacity="0.8">
            <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged, Delay=200}"
                     Padding="9,5"
                     FontSize="12"
                     Background="Transparent"
                     Foreground="{DynamicResource AppTextBrush}"
                     CaretBrush="{DynamicResource AppTextBrush}"
                     BorderThickness="0"
                     ToolTip="Search titles, text, links, and captions"
                     AutomationProperties.Name="Search notes"/>
        </Border>

        <Grid Grid.Row="3" Margin="0,10,0,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <StackPanel Orientation="Horizontal">
                <Button Style="{StaticResource ChromeButton}"
                        Command="{Binding NewNoteCommand}"
                        FontWeight="SemiBold"
                        Content="+ New note"/>
                <Button Style="{StaticResource ChromeButton}"
                        Command="{Binding RestoreAllCommand}"
                        Foreground="{DynamicResource AppMutedTextBrush}"
                        Margin="6,0,0,0"
                        Content="Restore all"/>
                <Button Style="{StaticResource ChromeButton}"
                        Command="{Binding HideAllCommand}"
                        Foreground="{DynamicResource AppMutedTextBrush}"
                        Margin="6,0,0,0"
                        Content="Hide all"/>
                <Button Style="{StaticResource ChromeButton}"
                        Click="ThemeStudio_Click"
                        Foreground="{DynamicResource AppMutedTextBrush}"
                        Margin="6,0,0,0"
                        ToolTip="Global theme"
                        Content="Theme…"/>
                <Button Style="{StaticResource ChromeButton}"
                        Command="{Binding OpenSettingsCommand}"
                        Foreground="{DynamicResource AppMutedTextBrush}"
                        Margin="6,0,0,0"
                        Content="Settings"/>
            </StackPanel>

            <ScrollViewer Grid.Row="1" Margin="0,10,0,0" VerticalScrollBarVisibility="Auto">
                <ItemsControl ItemsSource="{Binding NotesView}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Margin="0,0,0,8"
                                    Padding="12,8"
                                    CornerRadius="10"
                                    Background="{DynamicResource AppSurfaceBrush}"
                                    BorderBrush="{DynamicResource AppBorderBrush}"
                                    BorderThickness="1"
                                    Cursor="Hand"
                                    Tag="{Binding DataContext, RelativeSource={RelativeSource AncestorType={x:Type Window}}}"
                                    MouseLeftButtonDown="NoteCard_MouseLeftButtonDown">
                                <Border.ContextMenu>
                                    <ContextMenu>
                                        <MenuItem Header="Open"
                                                  Command="{Binding PlacementTarget.Tag.OpenNoteCommand, RelativeSource={RelativeSource AncestorType={x:Type ContextMenu}}}"
                                                  CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType={x:Type ContextMenu}}}"/>
                                        <MenuItem Header="Duplicate"
                                                  Command="{Binding PlacementTarget.Tag.DuplicateNoteCommand, RelativeSource={RelativeSource AncestorType={x:Type ContextMenu}}}"
                                                  CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType={x:Type ContextMenu}}}"/>
                                        <MenuItem Header="Delete note…"
                                                  Click="Delete_Click"
                                                  CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType={x:Type ContextMenu}}}"/>
                                    </ContextMenu>
                                </Border.ContextMenu>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="{Binding Title, TargetNullValue='(untitled)'}"
                                                   FontSize="13"
                                                   FontWeight="SemiBold"
                                                   Foreground="{DynamicResource AppTextBrush}"
                                                   TextTrimming="CharacterEllipsis"/>
                                        <TextBlock FontSize="11"
                                                   Foreground="{DynamicResource AppMutedTextBrush}"
                                                   Margin="0,2,0,0">
                                            <Run Text="{Binding StatusText, Mode=OneWay}"/>
                                            <Run Text="·"/>
                                            <Run Text="{Binding UpdatedText, Mode=OneWay}"/>
                                        </TextBlock>
                                    </StackPanel>
                                    <Button Grid.Column="1"
                                            Style="{StaticResource ChromeButton}"
                                            Click="NoteCardMenu_Click"
                                            Foreground="{DynamicResource AppMutedTextBrush}"
                                            VerticalAlignment="Center"
                                            ToolTip="Note options"
                                            AutomationProperties.Name="{Binding Title, StringFormat='Options for note {0}'}"
                                            Tag="{Binding DataContext, RelativeSource={RelativeSource AncestorType={x:Type Window}}}"
                                            Content="⋯">
                                        <Button.ContextMenu>
                                            <ContextMenu>
                                                <MenuItem Header="Open"
                                                          Command="{Binding PlacementTarget.Tag.OpenNoteCommand, RelativeSource={RelativeSource AncestorType={x:Type ContextMenu}}}"
                                                          CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType={x:Type ContextMenu}}}"/>
                                                <MenuItem Header="Duplicate"
                                                          Command="{Binding PlacementTarget.Tag.DuplicateNoteCommand, RelativeSource={RelativeSource AncestorType={x:Type ContextMenu}}}"
                                                          CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType={x:Type ContextMenu}}}"/>
                                                <MenuItem Header="Delete note…"
                                                          Click="Delete_Click"
                                                          CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType={x:Type ContextMenu}}}"/>
                                            </ContextMenu>
                                        </Button.ContextMenu>
                                    </Button>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Grid>

        <Grid Grid.Row="4" Margin="0,12,0,0">
            <TextBlock Text="Closing windows keeps Dikit in the tray — Quit exits."
                       FontSize="11"
                       Foreground="{DynamicResource AppMutedTextBrush}"
                       VerticalAlignment="Center"/>
            <Button Style="{StaticResource ChromeButton}"
                    Command="{Binding QuitCommand}"
                    Foreground="{DynamicResource AppMutedTextBrush}"
                    HorizontalAlignment="Right"
                    Content="Quit"/>
        </Grid>
    </Grid>
</Window>
